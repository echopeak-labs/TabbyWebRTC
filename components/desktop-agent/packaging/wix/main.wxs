<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product
    Id="*"
    Name="TabbyWebRTC Agent"
    Language="1033"
    Version="$(var.Version)"
    Manufacturer="TabbyWebRTC"
    UpgradeCode="c8f3e2a1-5b4d-4e9f-a6c2-1d8e7f9b0a3c">
    <Package
      InstallerVersion="500"
      Compressed="yes"
      InstallScope="perMachine"
      Platform="x64" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of TabbyWebRTC Agent is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="AppIcon" SourceFile="$(var.AgentIcon)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Feature Id="ProductFeature" Title="TabbyWebRTC Agent" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
    </Feature>
  </Product>

  <Fragment>
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLDIR" Name="TabbyWebRTC" />
      </Directory>
    </Directory>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="ProductComponents" Directory="INSTALLDIR">
      <Component Id="AgentBinary" Guid="*">
        <File
          Id="AgentExe"
          Source="$(var.AgentBinary)"
          KeyPath="yes"
          Name="tabbywebrtc-agent.exe" />
        <ServiceInstall
          Id="AgentServiceInstall"
          Type="ownProcess"
          Name="tabbywebrtc-agent"
          DisplayName="TabbyWebRTC Agent"
          Description="TabbyWebRTC desktop streaming agent"
          Start="auto"
          ErrorControl="normal" />
        <ServiceControl
          Id="AgentServiceControl"
          Name="tabbywebrtc-agent"
          Start="install"
          Stop="both"
          Remove="uninstall" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
