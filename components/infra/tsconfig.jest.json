{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "isolatedModules": true,
    "declaration": false,
    "inlineSourceMap": false,
    "inlineSources": false,
    "sourceMap": true,
    "noEmit": true
  },
  "include": [
    "test/**/*.ts",
    "lambda/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "cdk.out",
    "lib",
    "bin"
  ]
}
