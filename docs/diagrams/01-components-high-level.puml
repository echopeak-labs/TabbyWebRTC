@startuml tabbyrdp-components-high-level
skinparam backgroundColor #FAFAFA
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Helvetica
skinparam packageStyle rectangle
skinparam componentStyle rectangle

title TabbyRDP — High-Level System Architecture\n<size:12><i>AWS carries signaling only. Video and input are always P2P between browser and agent.</i></size>

actor "User" as user

package "Client Tier" #E8F4FD {
  component "Desktop Viewer\n(React PWA)" as viewer <<SPA>>
  component "Mobile Key\n(React PWA)" as mobile <<SPA>>
  component "Desktop Agent\n(tabbyrdp-agent)" as agent <<Rust>>
}

package "Identity" #FFF3E0 {
  cloud "Clerk" as clerk {
    component "JWKS / OAuth" as jwks
    component "User Metadata\n(pairedAgents)" as meta
  }
}

package "Control Plane (AWS)" #F3E5F5 {
  component "API Gateway\nWebSocket" as wsapi <<AWS>>
  component "API Gateway\nREST" as restapi <<AWS>>
  component "Lambda Functions" as lambda <<AWS>> {
    [connect / disconnect]
    [router]
    [auth-handler]
    [signal-handler]
    [agent-handler]
    [turn-credentials]
    [updates-handler]
  }
  database "DynamoDB" as ddb <<AWS>> {
    frame "connections"
    frame "pending-sessions"
    frame "agents"
    frame "source-locks"
  }
}

package "Static Hosting" #E8F5E9 {
  cloud "Cloudflare Pages" as pages {
    [frontend build]
  }
}

package "Media Relay (WAN fallback)" #FFEBEE {
  cloud "CoTURN VPS" as turn <<TURN>> {
    [STUN/TURN relay]
  }
  cloud "Google STUN" as stun
}

cloud "Cloudflare R2" as r2 <<Storage>> {
  [agent installers]
  [manifest.json]
}

user --> viewer : opens browser tab
user --> mobile : scans QR / approves
user --> agent : installs & runs agent

viewer --> pages : HTTPS (static assets)
mobile --> pages : HTTPS (static assets)

viewer --> wsapi : WSS signaling\n(SDP / ICE / session)
agent --> wsapi : WSS signaling\n(register / heartbeat / relay)

viewer --> restapi : GET /turn-credentials\nGET /agents
mobile --> restapi : POST /auth/approve\nPOST /agents/pair
agent --> restapi : pairing / updates

mobile --> clerk : sign-in / biometrics
lambda --> jwks : verify Clerk JWT
mobile --> meta : sync pairedAgents

wsapi --> lambda
restapi --> lambda
lambda --> ddb : read / write

viewer <--> agent : **WebRTC P2P**\nH.264 video + input data channel
viewer ..> turn : relay if NAT blocks P2P
agent ..> turn
viewer ..> stun
agent ..> stun

agent --> viewer : optional LAN path\n:7700 thumbnails / sources / local WS

lambda --> r2 : stream installer artifacts
viewer --> r2 : GET /downloads/{platform}\nvia REST proxy

legend right
  |= Path |= Traffic |= Through AWS? |
  | Signaling | SDP, ICE, auth msgs | Yes (few KB) |
  | Media | H.264 RTP, input DC | **No — direct P2P** |
  | LAN optimize | local WS :7700 | No |
  | TURN | relay when P2P fails | No (CoTURN VPS) |
endlegend

note bottom of viewer
  **Desktop Viewer** detects role via useDeviceType().
  Lazy-loads DesktopRouter or MobileRouter.
  Token in sessionStorage (volatile).
end note

note bottom of mobile
  **Mobile Key** never opens WebRTC.
  Holds Clerk JWT only; triggers TabbyRDP JWT issuance for desktop tab.
end note

note bottom of agent
  **Desktop Agent** is headless Rust binary.
  Always registered to AWS; also serves LAN on port 7700.
  One capture encoder per source; N peer connections per tab.
end note

@enduml
