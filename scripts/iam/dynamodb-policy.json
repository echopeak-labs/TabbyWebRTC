{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DynamoDBTableManagement",
      "Effect": "Allow",
      "Action": [
        "dynamodb:CreateTable",
        "dynamodb:DeleteTable",
        "dynamodb:DescribeTable",
        "dynamodb:UpdateTable",
        "dynamodb:DescribeTimeToLive",
        "dynamodb:UpdateTimeToLive",
        "dynamodb:DescribeContinuousBackups",
        "dynamodb:UpdateContinuousBackups",
        "dynamodb:ListTagsOfResource",
        "dynamodb:TagResource",
        "dynamodb:UntagResource"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:*:table/tabbywebrtc-connections-dev",
        "arn:aws:dynamodb:us-east-1:*:table/tabbywebrtc-connections-prod",
        "arn:aws:dynamodb:us-east-1:*:table/tabbywebrtc-pending-sessions-dev",
        "arn:aws:dynamodb:us-east-1:*:table/tabbywebrtc-pending-sessions-prod",
        "arn:aws:dynamodb:us-east-1:*:table/tabbywebrtc-agents-dev",
        "arn:aws:dynamodb:us-east-1:*:table/tabbywebrtc-agents-prod",
        "arn:aws:dynamodb:us-east-1:*:table/tabbywebrtc-source-locks-dev",
        "arn:aws:dynamodb:us-east-1:*:table/tabbywebrtc-source-locks-prod"
      ]
    },
    {
      "Sid": "DynamoDBGSIManagement",
      "Effect": "Allow",
      "Action": [
        "dynamodb:UpdateTable",
        "dynamodb:DescribeTable"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:*:table/tabbywebrtc-connections-dev/index/*",
        "arn:aws:dynamodb:us-east-1:*:table/tabbywebrtc-connections-prod/index/*",
        "arn:aws:dynamodb:us-east-1:*:table/tabbywebrtc-agents-dev/index/*",
        "arn:aws:dynamodb:us-east-1:*:table/tabbywebrtc-agents-prod/index/*"
      ]
    }
  ]
}
